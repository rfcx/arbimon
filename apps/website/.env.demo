# DO NOT WRITE SECRETS IN THIS FILE
# Demo-tier build (ADR-026): served at demo.arbimon.org against the LIVE
# prod data plane through the apps-demo services. Mirrors .env.production
# except same-origin demo URLs. (Re-created for the import-recordings
# rebuild 2026-08-12; prior demo builds used the same shape.)
VITE_APP_NAME=arbimon
VITE_GA_MEASUREMENT_ID=

# analytics OFF on demo
VITE_POSTHOG_ENABLED=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://track.arbimon.org
VITE_POSTHOG_AUTOCAPTURE=false

VITE_ARBIMON_LEGACY_BASE_URL=https://demo.arbimon.org
VITE_API_BASE_URL=https://demo.arbimon.org/api
VITE_CORE_API_BASE_URL=https://core.arbimon.org
VITE_MEDIA_API_BASE_URL=https://media.arbimon.org
VITE_DEVICE_API_BASE_URL=https://device-api.rfcx.org

###
# Feature toggles
###
VITE_TOGGLE_HEATMAP_CONFIG=false
VITE_TOGGLE_PROJECT_BACKUP=true
VITE_TOGGLE_PROJECT_BACKUP_TESTING=true
VITE_TOGGLE_CNN_EXPORT=true

# In-browser bulk uploader
VITE_INGEST_BASE_URL=https://ingest.rfcx.org